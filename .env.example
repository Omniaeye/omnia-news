# Export these values in the process environment. This file is not auto-loaded.
OMNIA_LAYA_REVISION=
OMNIA_LAYA_MODEL=english
OMNIA_LAYA_DEVICE=cpu
OMNIA_LAYA_THREADS=2
OMNIA_LAYA_MAX_LEN=512
OMNIA_LAYA_HEAD_MAX_LEN=192
OMNIA_LAYA_MAX_INPUT_BYTES=65536
OMNIA_LAYA_MIN_PROBABILITY=0.8
OMNIA_NEWS_DATABASE=var/news/decisions.sqlite3
OMNIA_NEWS_MAX_RECORDS=1000

# News policy: explicit switches, no automatic publication.
OMNIA_NEWS_ALLOW_LITERAL_SUPPRESSION=true
OMNIA_NEWS_ALLOW_OPERATIONAL_SUPPRESSION=true
OMNIA_NEWS_REVIEW_INCOMPLETE=true
OMNIA_NEWS_REVIEW_DELETED=true
OMNIA_NEWS_REVIEW_RETRACTIONS=true
OMNIA_NEWS_REVIEW_HTML=true
OMNIA_NEWS_ALLOWED_LANGUAGES=
OMNIA_NEWS_MAX_AGE_SECONDS=
